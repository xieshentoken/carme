# ============================================================
#  Carme 环境变量
#  复制成 .env 后填入你自己的 key。至少配一个供应商。
#  .env 已被 .gitignore 忽略，不会误提交。
# ============================================================

# ---------- 模型供应商（按你手上有的填，配几个都行）----------

# Anthropic —— 质量最稳，贵
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# DeepSeek —— 性价比之王，日常跑量首选
DEEPSEEK_API_KEY=

# 月之暗面 Kimi
MOONSHOT_API_KEY=

# 阿里通义千问
DASHSCOPE_API_KEY=

# 智谱 GLM
ZHIPU_API_KEY=

# OpenRouter —— 一个 key 打通几乎所有模型，想省事就配这个
OPENROUTER_API_KEY=

# ---------- 检索增强（可选）----------

# Tavily 搜索 key，配了就用它替代 DuckDuckGo
TAVILY_API_KEY=

# 自建 SearxNG 地址，配了优先用它
# CARME_SEARX_URL=http://127.0.0.1:8888

# ---------- 服务 ----------

# 启动服务前必须配置随机管理令牌；浏览器只用它配对一次，换取可撤销的 7 天 Cookie。
# CARME_TOKEN=换成你自己的随机字符串
# HTTPS / Tunnel 必须设置准确的公开 Origin，用于 Secure Cookie 和 Origin/CSRF 校验。
# CARME_PUBLIC_ORIGIN=https://carme.example.com
# 仅临时本机开发可显式启用无认证；仅允许 loopback，禁止通过 Tunnel 发布。
# CARME_DEV_NO_AUTH=1
# CARME_BIND_HOST=127.0.0.1
# Pi 使用 config/isolation.yaml 中的专用 profile。M1 不启动宿主 Pi；M2 接通受管执行器前返回 unavailable。

# ---------- 外网 HTTPS（可选，Cloudflare named Tunnel）----------
# 这里只保存路径 / 选择，不保存 Tunnel 凭据或 Access 密钥；实际配置在网页设置中填写。
# CARME_CLOUDFLARE_CONFIG=./deploy/cloudflared/carme-tunnel.yml
# CARME_CLOUDFLARE_HOSTNAME=carme.example.com
# CARME_CLOUDFLARE_PROTOCOL=http2
# CARME_CLOUDFLARE_PID_FILE=./.local/active/cloudflared.pid
# CARME_CLOUDFLARE_LOG_FILE=./.local/active/cloudflared.log

# 数据库与工作目录位置（默认 ./data）
# CARME_DATA_DIR=./data

# 日志级别
CARME_LOG_LEVEL=INFO

# ---------- 审批通知（可选，但强烈建议配）----------
# 代操作遇到不可逆动作会挂起等你确认。不配这个，你就得一直盯着网页；
# 配了之后确认请求会直接推到你手机上，地铁上也能批。
# 按 URL 自动识别通道，四种任选其一：

# Bark（iOS，最省事）
# CARME_WEBHOOK_URL=https://api.day.app/你的key

# Server 酱（微信推送）
# CARME_WEBHOOK_URL=https://sctapi.ftqq.com/你的key.send
# CARME_NOTIFY_SECRET=

# Telegram（另需 chat_id）
# CARME_WEBHOOK_URL=https://api.telegram.org/bot<token>/sendMessage
# CARME_TELEGRAM_CHAT_ID=

# 通用 webhook（钉钉/飞书/自建，会 POST 一段 JSON）
# CARME_WEBHOOK_URL=https://your-endpoint/hook

# 通知里带的回跳地址，方便你从手机直接点回界面处理
# CARME_PUBLIC_URL=http://192.168.1.10:8787
