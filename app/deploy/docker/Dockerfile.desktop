FROM node:22.22.2-bookworm-slim@sha256:9f6d5975c7dca860947d3915877f85607946403fc55349f39b4bc3688448bb6e AS node
WORKDIR /opt/desktop
COPY deploy/docker/desktop/package*.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund

FROM mcr.microsoft.com/playwright/python:v1.63.0-noble@sha256:72bd171a9ffc2b4b59532aaa6210e21014d07093120dc25528870c0b840da1f0
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb openbox tint2 pcmanfm mousepad xterm dbus-x11 at-spi2-core \
    libatk-adaptor xdotool xclip imagemagick fonts-noto-cjk \
    python3-venv build-essential git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /opt/desktop /opt/desktop
COPY deploy/docker/desktop/computer-use.ts /opt/desktop/computer-use.ts
COPY deploy/docker/requirements-control.lock deploy/docker/requirements-browser.lock /tmp/
RUN python -m pip install --target /opt/browser --no-cache-dir --require-hashes \
    -r /tmp/requirements-control.lock -r /tmp/requirements-browser.lock \
    && rm /tmp/requirements-*.lock
WORKDIR /app
COPY carme ./carme
ENV HOME=/home/bot PYTHONPATH=/opt/browser PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 CARME_LOAD_ENV=0 DISPLAY=:99 NO_AT_BRIDGE=0 \
    GTK_MODULES=gail:atk-bridge PI_COMPUTER_USE_HEADLESS=false \
    PI_COMPUTER_USE_CDP_PORT=9222 PI_COMPUTER_USE_CHROME_EXECUTABLE=/software/chrome/chrome
USER 1000:1000
ENTRYPOINT ["python", "-B", "-m", "carme.docker_desktop", "worker"]
