FROM python:3.13.12-slim-bookworm@sha256:a58daefb915e1e03ad48f3ca4df8832065412c5c35cacb9d39f4229184de12b6
COPY deploy/docker/apt-action.lock /tmp/apt-action.lock
RUN apt-get update && xargs -r -a /tmp/apt-action.lock apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* /tmp/apt-action.lock && useradd --uid 1000 --no-create-home worker
COPY deploy/docker/requirements-action.lock /tmp/requirements.lock
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements.lock && rm /tmp/requirements.lock
WORKDIR /app
COPY carme/__init__.py carme/engines.py carme/security.py carme/worker.py carme/projects.py carme/attachments.py carme/mcp.py ./carme/
COPY carme/tools/__init__.py carme/tools/base.py ./carme/tools/
COPY deploy/docker/worker-entrypoint.py /app/worker-entrypoint.py
ENV HOME=/runtime TMPDIR=/runtime PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MPLCONFIGDIR=/runtime/matplotlib
USER 1000:1000
ENTRYPOINT ["python", "/app/worker-entrypoint.py"]
